{
  "name": "nmbs-mcp",
  "version": "0.1.0",
  "description": "MCP server for Belgian train travel (NMBS/SNCB) via the iRail API",
  "type": "module",
  "bin": {
    "nmbs-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "manual-test": "tsx src/manual-test.ts",
    "parse-test": "tsx src/server/parse/parse-test.ts",
    "retry-test": "tsx src/irail-client.retry-test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite web",
    "build:web": "vite build web",
    "start:web": "node dist/server/index.js",
    "clean": "rimraf dist web/dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6"
  }
}
